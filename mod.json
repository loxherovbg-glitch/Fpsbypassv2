{
    "geode": "5.3.0",
    "gd": {
        "win": "2.2081",
        "android": "2.2081",
        "mac": "2.2081",
        "ios": "2.2081"
    },
    "id": "lo.fpsbypass",
    "name": "LO FPS Bypass",
    "version": "v1.0.0",
    "developer": "LO & ENI",
    "description": "FPS Bypass for Geometry Dash",
    "settings": {
        "enabled": {
            "type": "bool",
            "name": "Enable FPS Bypass",
            "default": true
        },
        "fps-value": {
            "type": "int",
            "name": "Target FPS",
            "default": 240,
            "min": 30,
            "max": 1000,
            "control": "slider"
        },
        "disable-vsync": {
            "type": "bool",
            "name": "Disable V-Sync",
            "default": false
        }
    }
}
